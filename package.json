{
  "name": "@jankrajewskiit/configs",
  "version": "2.0.4",
  "description": "Shared tooling presets (ESLint, Prettier, Stylelint, TypeScript, Vite, lint-staged, Husky, Nginx) for SolidJS apps and libraries.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankrajewskiit/configs.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "eslint-config",
    "prettier-config",
    "stylelint-config",
    "tsconfig",
    "vite-config",
    "solidjs",
    "lint-staged",
    "husky",
    "nginx"
  ],
  "prettier": "./prettier/index.json",
  "exports": {
    "./eslint": {
      "types": "./eslint/index.d.mts",
      "import": "./eslint/index.mjs"
    },
    "./prettier": "./prettier/index.json",
    "./stylelint": "./stylelint/index.json",
    "./tsconfig/app": "./tsconfig/app.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./tsconfig/app-vite": "./tsconfig/app-vite.json",
    "./tsconfig/node-vite": "./tsconfig/node-vite.json",
    "./tsconfig/lib": "./tsconfig/lib.json",
    "./tsconfig/test": "./tsconfig/test.json",
    "./vite": {
      "types": "./vite/index.d.mts",
      "import": "./vite/index.mjs"
    },
    "./lint-staged": {
      "types": "./lint-staged/index.d.mts",
      "import": "./lint-staged/index.mjs"
    },
    "./husky/pre-commit": "./husky/pre-commit.sh",
    "./nginx/spa": "./nginx/spa.conf"
  },
  "files": [
    "eslint",
    "prettier",
    "stylelint",
    "tsconfig",
    "vite",
    "lint-staged",
    "husky",
    "nginx",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && publint",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/js": "^9.x",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.61.0",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-solid": "^2.11.12"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "lint-staged": ">=17.0.0",
    "prettier": ">=3.0.0",
    "stylelint": ">=17.0.0",
    "typescript": ">=5.5.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-dts": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.9.1",
    "publint": "^0.3.21"
  }
}
