{
  "name": "@jankrajewskiit/configs",
  "version": "3.4.2",
  "description": "Shared tooling presets (ESLint, Prettier, Stylelint, TypeScript, Vite, lint-staged, Husky, Nginx) for SolidJS apps and libraries.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvetconfigs.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "eslint-config",
    "prettier-config",
    "stylelint-config",
    "tsconfig",
    "vite-config",
    "solidjs",
    "lint-staged",
    "husky",
    "nginx"
  ],
  "files": [
    "eslint",
    "prettier",
    "stylelint",
    "tsconfig",
    "vite",
    "lint-staged",
    "husky",
    "nginx",
    "README.md",
    "LICENSE",
    "env",
    "scripts",
    "security",
    "docker",
    "editor",
    "CHANGELOG.md"
  ],
  "exports": {
    "./eslint": {
      "types": "./eslint/index.d.mts",
      "import": "./eslint/index.mjs"
    },
    "./prettier": "./prettier/index.json",
    "./stylelint": "./stylelint/index.json",
    "./tsconfig/app": "./tsconfig/app.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./tsconfig/app-vite": "./tsconfig/app-vite.json",
    "./tsconfig/node-vite": "./tsconfig/node-vite.json",
    "./tsconfig/lib": "./tsconfig/lib.json",
    "./tsconfig/test": "./tsconfig/test.json",
    "./vite": {
      "types": "./vite/index.d.mts",
      "import": "./vite/index.mjs"
    },
    "./lint-staged": {
      "types": "./lint-staged/index.d.mts",
      "import": "./lint-staged/index.mjs"
    },
    "./husky/pre-commit": "./husky/pre-commit.sh",
    "./nginx/spa": "./nginx/spa.conf",
    "./stylelint/velvet": "./stylelint/velvet.json",
    "./env": {
      "types": "./env/index.d.mts",
      "import": "./env/index.mjs"
    },
    "./nginx": {
      "types": "./nginx/index.d.mts",
      "import": "./nginx/index.mjs"
    },
    "./tsconfig/declarations": "./tsconfig/declarations.json",
    "./editor/settings": "./editor/settings.json",
    "./editor/extensions": "./editor/extensions.json"
  },
  "prettier": "./prettier/index.json",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run toolchain && npm run editor:check && npm run lint && npm run format:check && npm run typecheck && npm run nginx:check && publint --strict",
    "prepublishOnly": "npm run verify",
    "prepare": "husky",
    "toolchain": "node scripts/toolchain.mjs",
    "audit:deps": "node scripts/audit.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "nginx:sync": "node scripts/sync-nginx.mjs --write",
    "nginx:check": "node scripts/sync-nginx.mjs",
    "editor:sync": "node scripts/sync-editor.mjs --write",
    "editor:check": "node scripts/sync-editor.mjs",
    "deps:check": "knip --no-exit-code --reporter json",
    "deps:strict": "knip"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": ">=6.0.0 <6.1.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "lint-staged": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.18.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "npm@12.2.0",
  "bin": {
    "configs-toolchain": "./scripts/toolchain.mjs",
    "configs-audit": "./scripts/audit.mjs",
    "configs-clean-dist": "./scripts/clean-dist.mjs",
    "configs-spa": "./scripts/prepare-spa.mjs",
    "configs-editor": "./scripts/sync-editor.mjs"
  }
}
