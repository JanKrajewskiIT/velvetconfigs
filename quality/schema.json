{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velvet code quality policy",
  "type": "object",
  "required": ["kind", "paths", "tsConfig"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "enum": ["browser-library", "browser-app", "tooling"] },
    "paths": { "$ref": "#/$defs/paths" },
    "browserPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tsConfig": { "type": "string", "pattern": "\\.json$" },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "duplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minTokens": { "type": "integer", "minimum": 50 },
        "minLines": { "type": "integer", "minimum": 5 },
        "maxPercentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
