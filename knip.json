{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "eslint/index.mjs!",
    "vite/index.mjs!",
    "lint-staged/index.mjs!",
    "env/index.mjs!",
    "nginx/index.mjs!",
    "scripts/*.mjs!"
  ],
  "project": ["src/**/*.{ts,tsx}", "*.{ts,mjs}", "scripts/*.mjs"],
  "ignore": [".agents/**", "dist/**", ".deployment/**"],
  "ignoreDependencies": ["@typescript/native"],
  "includeEntryExports": false
}
