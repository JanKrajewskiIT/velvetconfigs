{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "eslint/index.mjs!",
    "vite/index.mjs!",
    "lint-staged/index.mjs!",
    "env/index.mjs!",
    "nginx/index.mjs!",
    "browser/index.mjs!",
    "scripts/*.mjs!",
    ".github/scripts/sync-codeql.mjs",
    "quality/index.mjs!"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "*.{ts,mjs}",
    "scripts/*.mjs",
    ".github/scripts/*.mjs",
    "quality/**/*.mjs",
    "eslint/**/*.mjs",
    "vite/**/*.mjs",
    "env/**/*.mjs",
    "lint-staged/**/*.mjs",
    "nginx/**/*.mjs",
    "browser/**/*.mjs"
  ],
  "ignore": [".agents/**", "dist/**", ".deployment/**"],
  "ignoreDependencies": ["@typescript/native", "dependency-cruiser", "jscpd", "lint-staged"],
  "ignoreBinaries": ["trivy"],
  "includeEntryExports": false
}
