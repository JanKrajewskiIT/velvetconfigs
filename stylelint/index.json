{
  "extends": "stylelint-config-standard",
  "rules": {
    "selector-class-pattern": ["^[a-z][a-zA-Z0-9]*$", { "message": "Expected class selector to be camelCase" }],
    "keyframes-name-pattern": ["^[a-z][a-zA-Z0-9]*$", { "message": "Expected keyframe name to be camelCase" }],
    "custom-property-pattern": null,
    "no-descending-specificity": null,
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["global", "local", "export"] }],
    "property-no-vendor-prefix": [true, { "ignoreProperties": ["backface-visibility", "line-clamp"] }],
    "declaration-property-value-no-unknown": [true, { "ignoreProperties": { "/.+/": ["/^var\\(--.+\\)$/"] } }]
  },
  "overrides": [
    {
      "files": ["**/*.module.css"],
      "rules": {
        "property-no-unknown": [true, { "ignoreProperties": ["composes"], "ignoreSelectors": [":export"] }]
      }
    }
  ]
}
