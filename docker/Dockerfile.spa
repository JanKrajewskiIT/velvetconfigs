FROM nginx:1.31.9-alpine-slim@sha256:5bfced78d24d644270bedb0a9968697042e38d5c03fb6354603df025279c1cbe

COPY prepare-runtime.sh /tmp/prepare-runtime.sh
RUN sh /tmp/prepare-runtime.sh && rm /tmp/prepare-runtime.sh
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY locations.conf /etc/nginx/snippets/velvet-spa.conf
COPY dist/ /usr/share/nginx/html/

USER nginx
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
